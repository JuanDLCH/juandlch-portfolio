// Voice Lab backend (worker/) and, with `assets`, the static site itself.
// Secrets: `wrangler secret put OPENAI_API_KEY | TURNSTILE_SECRET | IP_SALT`
// (locally: .dev.vars, see .dev.vars.example). Use a key from an OpenAI
// project of its own, with a monthly budget cap.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "juandlch-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Only juandlch.dev: the workers.dev copy of the site would be a duplicate
  // without Cloudflare Access on /admin.
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Pages are linked without a trailing slash (/lab/voice).
    "html_handling": "drop-trailing-slash",
    // Unknown paths get the site's 404 page (src/pages/404.astro).
    "not_found_handling": "404-page",
    // The API is the Worker's; everything else is the static build.
    "run_worker_first": ["/api/*", "/admin/api/*", "/cv/*"],
  },
  // Requests per IP to /api/* (worker/index.ts): far above what the pages
  // send, it only stops scripts hammering the API (and D1 writes).
  "ratelimits": [
    {
      "name": "API_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "QUOTA", "class_name": "Quota" },
      { "name": "CALL", "class_name": "VoiceCall" },
    ],
  },
  // Lab metrics and visitor questions (worker/metrics.ts). The Worker
  // creates its tables on first use.
  "d1_databases": [
    {
      "binding": "LAB_DB",
      "database_name": "portfolio-analytics",
      "database_id": "9ab0ac50-d34f-4e77-800d-f861eaed9ab2",
    },
  ],
  // 00:10 Bogotá: metrics retention and the day's insights batch; hourly: the
  // insights moved along (worker/insights.ts). Keep the first in sync with
  // DAILY in worker/index.ts.
  "triggers": { "crons": ["10 5 * * *", "40 * * * *"] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Quota", "VoiceCall"] }],
  "vars": {
    // The production origin(s), comma-separated (dev: .dev.vars). Empty, every
    // session is refused.
    "SITE_ORIGIN": "https://juandlch.dev",
    "VOICE_MODEL": "gpt-realtime-2.1-mini",
    "VOICE_NAME": "coral",
    "VOICE_REASONING": "",
    "MAX_PER_IP": "1",
    "MAX_PER_DAY": "40",
    "SESSION_S": "300",
    // A voice call hangs up once it has cost this much (USD).
    "VOICE_CALL_USD": "0.30",
    // Chat on the site's key: messages per IP per day, and USD per IP and
    // per day for the whole site.
    "CHAT_MSGS_PER_IP": "60",
    "CHAT_USD_PER_IP": "0.40",
    "CHAT_USD_PER_DAY": "10",
    // Daily insights over the visitors' messages: a cheap model labels each
    // message (validated in code), a stronger one writes the report (either
    // empty: off).
    "INSIGHTS_LABEL_MODEL": "gpt-6-luna",
    "INSIGHTS_REPORT_MODEL": "gpt-6.1-sol",
    "INSIGHTS_MAX_CONVS": "150",
    "INSIGHTS_USD_PER_DAY": "1",
    // Cloudflare Access app on juandlch.dev/admin (the dashboard). Not secret:
    // the Worker checks every /admin/api request's Access JWT against them.
    "ACCESS_TEAM": "divine-band-0b8a.cloudflareaccess.com",
    "ACCESS_AUD": "728d29e20226b2cfd54f48717e91b5a5fd2498b8fe5915ba9d162aa1ca653e12",
    // Web Analytics read by the dashboard (token: the CF_ANALYTICS_TOKEN
    // secret).
    "CF_ACCOUNT_ID": "df621aa04c0f772cfd9ca8a5309558cc",
    "CF_SITE_TAG": "dadf01de0c8d487fb4323644dd63592d",
    // The CV downloads come from this repo (worker/cv.ts; token: the
    // CV_GITHUB_TOKEN secret).
    "CV_REPO": "JuanDLCH/cv",
    "MOCK_OPENAI": "",
  },
  "observability": { "enabled": true },
}
