// Voice Lab backend (worker/) and, with `assets`, the static site itself.
// Secrets: `wrangler secret put OPENAI_API_KEY | TURNSTILE_SECRET | IP_SALT`
// (locally: .dev.vars, see .dev.vars.example). Use a key from an OpenAI
// project of its own, with a monthly budget cap.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "juandlch-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Pages are linked without a trailing slash (/lab/voice).
    "html_handling": "drop-trailing-slash",
    // The API is the Worker's; everything else is the static build.
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "QUOTA", "class_name": "Quota" },
      { "name": "CALL", "class_name": "VoiceCall" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Quota", "VoiceCall"] }],
  "vars": {
    // The production origin(s), comma-separated (dev: .dev.vars). Empty, every
    // session is refused.
    "SITE_ORIGIN": "",
    "VOICE_MODEL": "gpt-realtime-2.1-mini",
    "VOICE_NAME": "coral",
    "VOICE_REASONING": "",
    "MAX_PER_IP": "1",
    "MAX_PER_DAY": "20",
    "SESSION_S": "300",
    // A voice call hangs up once it has cost this much (USD).
    "VOICE_CALL_USD": "0.30",
    // Chat on the site's key: messages per IP per day, and USD per IP and
    // per day for the whole site.
    "CHAT_MSGS_PER_IP": "40",
    "CHAT_USD_PER_IP": "0.25",
    "CHAT_USD_PER_DAY": "3",
    "MOCK_OPENAI": "",
  },
  "observability": { "enabled": true },
}
