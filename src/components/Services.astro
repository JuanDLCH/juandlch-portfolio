---
// Services mode only (src/lab/site.ts): what he builds for a business, each
// card with its live demo in the lab (or the booking page, for consulting),
// then how he works with a client (Leading, in the slot).
import type { Content } from '../i18n';
import { CONTACT } from '../lab/chat/contact';
import T from './T.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  x: Content['x'];
  services: Content['services'];
  n?: string;
}
const { x, services, n = '01' } = Astro.props;
// Stroke icons, in the order of `services` in content.ts.
const icons = [
  '<path d="M4 5h16v11H9l-5 4z"/><path d="M8 9h8M8 12h5"/>',
  '<path d="M4 4h10l6 6v10H4z"/><path d="M14 4v6h6"/><path d="M8 15l2 2 4-4"/>',
  '<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><path d="M12 19v3"/>',
  '<path d="M6 3h9l4 4v14H6z"/><circle cx="11.5" cy="13" r="3"/><path d="M14 15.5l2.5 2.5"/>',
  '<rect x="3" y="3" width="6" height="6"/><rect x="15" y="15" width="6" height="6"/><rect x="15" y="3" width="6" height="6"/><path d="M9 6h6M18 9v6"/>',
];
const booking = CONTACT.booking ?? '#contact';
---

<section id="services" class="border-line border-t py-section">
  <div>
    <SectionHeading n={n}>
      <T v={x.servicesTitle} />
    </SectionHeading>
    <p class="mt-4 mb-0 text-h2 leading-none font-medium tracking-[-0.045em]">
      <T v={x.servicesA} />
      <span class="text-accent">
        <T v={x.servicesB} />
      </span>
    </p>
    <p class="text-body mt-3 mb-0 max-w-[620px] text-sm leading-[1.55]">
      <T v={x.servicesSub} />
    </p>
  </div>

  <ul class="bg-line border-line m-0 mt-head grid list-none grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] gap-px border p-0">
    {services.map((s, i) => {
      const demo = !!s.href;
      return (
        <li class="bg-panel hover:bg-bg group relative flex flex-col p-card transition-colors">
          <span
            aria-hidden="true"
            class="bg-accent absolute top-0 left-0 size-[7px]"
          />
          <div class="flex items-center justify-between gap-3">
            <span class="tag text-muted">
              <T v={s.tag} />
            </span>
            <span
              aria-hidden="true"
              class="border-line2 text-accent grid size-9 place-items-center border"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons[i]}
              />
            </span>
          </div>
          <h3 class="mt-3 mb-1.5 text-h3 font-medium tracking-[-0.02em]">
            <T v={s.title} />
          </h3>
          <p class="text-body m-0 flex-1 text-sm leading-[1.5]">
            <T v={s.body} />
          </p>
          <a
            href={demo ? (s.href as string) : booking}
            {...(demo
              ? { 'data-astro-prefetch': 'hover' }
              : { target: '_blank', rel: 'noopener noreferrer' })}
            class="mono text-accent mt-4 inline-flex items-center gap-2 self-start text-xs tracking-[0.06em] uppercase no-underline"
          >
            <T v={demo ? x.serviceTry : x.serviceTalk} />
            <span class="jd-arrow" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      );
    })}
  </ul>
  {/* Not only AI: a short mention of full-stack web work, with this site
      as the example. */}
  <p class="border-line2 text-body mt-stack mb-0 flex flex-wrap items-baseline gap-x-3 gap-y-1 border border-dashed px-4 py-3 text-sm leading-[1.55]">
    <span class="mono text-accent text-[11px] tracking-[0.08em] uppercase">
      <T v={x.fullTag} />
    </span>
    <span class="min-w-0 flex-[1_1_320px]">
      <T v={x.fullBody} />{' '}
      <a href="/lab/chat?case=meet" class="text-accent">
        <T v={x.fullLink} /> →
      </a>
    </span>
  </p>
  <p class="text-muted mt-stack mb-0 text-sm leading-[1.55]">
    <T v={x.servicesNote} />{' '}
    <a
      href={booking}
      target="_blank"
      rel="noopener noreferrer"
      class="text-accent"
    >
      <T v={x.serviceTalk} /> →
    </a>
  </p>
  <slot />
</section>
