---
import type { Content } from '../i18n';
import CornerMarks from './CornerMarks.astro';
import FlowDiagram from './FlowDiagram.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  x: Content['x'];
  flow: Content['ragFlow'];
  ideas: Content['ragIdeas'];
}
const { x, flow, ideas } = Astro.props;
---

<section id="rag" class="border-line border-t py-section">
  <div>
    <SectionHeading n="06">{x.ragTitle}</SectionHeading>
    <p class="mt-4 mb-0 text-h2 leading-[1.05] font-medium tracking-[-0.045em]">
      {x.ragA}
      <span class="text-accent">{x.ragB}</span>
    </p>
    <p class="text-body mt-3 mb-0 max-w-[640px] text-sm leading-[1.55]">
      {x.ragSub}
    </p>
  </div>

  <div class="mt-head flex flex-wrap items-stretch gap-x-gutter gap-y-6">
    <figure class="bg-panel dots border-line2 relative m-0 min-w-0 flex-[1_1_380px] border p-card">
      <CornerMarks only={['tl']} offset="10px" size="14px" />
      <CornerMarks only={['br']} offset="10px" size="14px" />
      <div class="mono text-muted text-[10px] tracking-[0.08em] uppercase">
        {x.ragFigTag}
      </div>
      <FlowDiagram nodes={flow} label={x.ragFigLabel} dense />
    </figure>
    <ol class="m-0 flex min-w-0 flex-[1_1_380px] list-none flex-col justify-between p-0">
      {ideas.map((r) => (
        <li class="border-line2 flex gap-4 border-t py-3 first:pt-0 first:border-t-0">
          <span class="mono text-accent flex-none pt-0.5 text-[13px] font-semibold">
            {r.n}
          </span>
          <div>
            <h3 class="m-0 text-h3 font-medium tracking-[-0.02em]">
              {r.title}
            </h3>
            <p class="text-body mt-1 mb-0 text-sm leading-[1.5]">{r.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
