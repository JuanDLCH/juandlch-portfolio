---
import type { Content } from '../i18n';
import SectionHeading from './SectionHeading.astro';

interface Props {
  x: Content['x'];
  cycle: Content['cycle'];
}
const { x, cycle } = Astro.props;
// Stroke icons for the five steps, in order.
const icons = [
  '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.5-4.5"/>',
  '<rect x="3" y="3" width="6" height="6"/><rect x="15" y="15" width="6" height="6"/><rect x="15" y="3" width="6" height="6"/><path d="M9 6h6M18 9v6"/>',
  '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.4 3.3-5.5 6.5-5.5s5.7 2.1 6.5 5.5"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18.5 14.8c1.6.8 2.6 2.6 3 5.2"/>',
  '<path d="M12 3l8 3v6c0 4.5-3.4 7.7-8 9-4.6-1.3-8-4.5-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/>',
];
---

<section id="leading" class="border-line border-t py-[88px]">
  <div class="flex flex-wrap gap-x-16 gap-y-8">
    <SectionHeading n="02" class="flex-[1_1_280px]">
      {x.leadTitle}
    </SectionHeading>
    <p class="m-0 flex-[3_1_560px] text-2xl leading-[1.45] font-light tracking-[-0.01em] text-pretty">
      {x.leadIntro}
    </p>
  </div>
  <ol class="bg-line border-line m-0 mt-12 grid list-none grid-cols-[repeat(auto-fit,minmax(min(230px,100%),1fr))] gap-px border p-0">
    {cycle.map((p, i) => (
      <li class="bg-panel p-[26px]">
        <div class="flex items-center justify-between gap-3">
          <div class="eyebrow text-accent">{p.tag}</div>
          <span
            aria-hidden="true"
            class="border-line2 text-accent grid size-9 place-items-center border"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={icons[i]}
            />
          </span>
        </div>
        <h3 class="mt-[18px] mb-2 text-xl font-medium tracking-[-0.02em]">
          {p.title}
        </h3>
        <p class="text-body m-0 text-[15px] leading-[1.55]">{p.body}</p>
      </li>
    ))}
  </ol>
</section>
