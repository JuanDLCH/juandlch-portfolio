---
interface Props {
  n: string;
  class?: string;
}
const { n, class: cls } = Astro.props;
---

<h2 class:list={['m-0 flex items-center gap-3', cls]}>
  <span class="mono text-accent text-[clamp(20px,2vw,28px)] leading-none font-medium">
    {n}
  </span>
  <span aria-hidden="true" class="bg-accent h-5 w-px"></span>
  <span class="mono text-ink text-[clamp(13px,1.15vw,16px)] font-semibold tracking-[0.1em] uppercase">
    <slot />
  </span>
</h2>
