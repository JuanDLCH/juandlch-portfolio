---
import type { Content } from '../i18n';
import SectionHeading from './SectionHeading.astro';
import Waveform from './Waveform.astro';

interface Props {
  x: Content['x'];
}
const { x } = Astro.props;
const mic =
  '<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/>';
const preview =
  'bg-bg dots border-line2 box-border flex flex-1 flex-col border-b p-card';
---

<section id="lab" class="border-line border-t py-section">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <SectionHeading n="04">{x.labTitle}</SectionHeading>
      <p class="mt-2 mb-0 text-h2 leading-none font-medium tracking-[-0.045em]">
        {x.labA}
        <span class="text-accent">{x.labB}</span>
      </p>
    </div>
    <p class="text-body m-0 max-w-[440px] text-base leading-[1.55]">
      {x.labSub}
    </p>
  </div>

  <div class="mt-block grid grid-cols-[repeat(auto-fit,minmax(min(420px,100%),1fr))] gap-4">
    <a
      href="#voice"
      class="jd-card bg-panel border-accent flex flex-col border no-underline"
    >
      <div aria-hidden="true" class:list={[preview, 'gap-4']}>
        <div class="mono flex items-center justify-between gap-3 text-[10px] tracking-[0.08em] uppercase">
          <span class="text-accent flex items-center gap-2">
            <span class="jd-blink bg-accent size-1.5"></span>
            {x.agentSpeaking}
          </span>
          <span class="text-muted">{x.pvSim} · 00:42</span>
        </div>
        <Waveform variant="mini" />
        <div class="flex flex-col gap-2 text-sm leading-[1.45]">
          <div class="text-muted">
            <span class="mono mr-2 text-[10px] tracking-[0.08em] uppercase">
              {x.pvYou}
            </span>
            {x.voiceUser}
          </div>
          <div class="text-ink">
            <span class="mono text-accent mr-2 text-[10px] tracking-[0.08em] uppercase">
              {x.pvAgent}
            </span>
            {x.voiceAgent}
            <span class="bg-accent ml-[3px] inline-block h-3.5 w-[7px] align-[-2px] [animation:jd-blink_1s_steps(1)_infinite]"></span>
          </div>
        </div>
        <div class="mt-auto flex flex-wrap items-center justify-between gap-2.5">
          <div class="mono text-chip flex flex-wrap gap-1.5 text-[10px]">
            {['STT', 'LLM', 'TTS'].map((k) => (
              <span class="border-line2 border px-2 py-[5px]">{k} — ms</span>
            ))}
          </div>
          <div class="flex gap-1.5">
            <span class="border-line2 text-ink grid size-[34px] place-items-center border">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={mic + '<path d="M12 19v3"/>'}
              />
            </span>
            <span class="bg-accent text-on-accent grid size-[34px] place-items-center">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <rect x="6" y="6" width="12" height="12"></rect>
              </svg>
            </span>
          </div>
        </div>
      </div>
      <div class="flex flex-col gap-1.5 p-card">
        <span class="eyebrow text-accent">{x.lab1Tag}</span>
        <span class="text-h3 font-medium tracking-[-0.03em]">
          Realtime Voice Lab
        </span>
        <span class="text-body text-sm leading-normal">{x.lab1Body}</span>
        <span class="mono text-accent mt-1 text-[13px] font-medium">
          {x.labCta} <span class="jd-arrow">→</span>
        </span>
      </div>
    </a>

    <a
      href="#chat"
      class="jd-card bg-panel border-line2 flex flex-col border no-underline"
    >
      <div aria-hidden="true" class:list={[preview, 'gap-2']}>
        <div class="mono flex items-center justify-between gap-3 text-[10px] tracking-[0.06em]">
          <span class="flex gap-1.5">
            <span class="border-line2 text-chip border px-2 py-1">
              Claude ▾
            </span>
            <span class="border-line2 text-muted border px-2 py-1">BYOK</span>
          </span>
          <span class="text-muted tracking-[0.08em] uppercase">{x.pvSim}</span>
        </div>
        <div class="flex max-w-[78%] flex-col items-end gap-1.5 self-end">
          <span class="mono border-line2 text-chip inline-flex items-center gap-1.5 border px-2 py-[5px] text-[10px]">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
            >
              <path d="M6 2h9l5 5v15H6z"></path>
              <path d="M14 2v6h6"></path>
            </svg>
            {x.chatFile}
          </span>
          <span class="bg-panel border-line2 text-ink border px-3 py-[9px] text-sm leading-[1.45]">
            {x.chatUser}
          </span>
        </div>
        <div class="border-line2 text-muted mono flex flex-wrap items-center gap-2 border border-dashed px-2.5 py-[7px] text-[11px]">
          <span class="text-accent">tool</span>
          <span>search_menu({'{ vegetarian: true }'})</span>
          <span class="text-chip ml-auto">✓ {x.toolResult}</span>
        </div>
        <div class="border-accent text-ink max-w-[86%] border-l-2 px-3 py-[9px] text-sm leading-normal">
          {x.chatAgent}
          <span class="bg-accent ml-[3px] inline-block h-3.5 w-[7px] align-[-2px] [animation:jd-blink_1s_steps(1)_infinite]"></span>
        </div>
        <div class="border-line2 bg-panel text-muted mt-auto flex items-center gap-2.5 border py-2 pr-2 pl-3">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 11.5l-8.6 8.6a5 5 0 0 1-7.1-7.1l8.6-8.6a3.3 3.3 0 0 1 4.7 4.7l-8.6 8.6a1.7 1.7 0 0 1-2.4-2.4l8-8"></path>
          </svg>
          <span class="flex-auto text-[13px]">{x.chatPlaceholder}</span>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={mic}
          />
          <span class="bg-accent text-on-accent grid size-[30px] place-items-center">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 19V5M5 12l7-7 7 7"></path>
            </svg>
          </span>
        </div>
      </div>
      <div class="flex flex-col gap-1.5 p-card">
        <span class="eyebrow text-muted">{x.lab2Tag}</span>
        <span class="text-h3 font-medium tracking-[-0.03em]">
          Multimodal Chat
        </span>
        <span class="text-body text-sm leading-normal">{x.lab2Body}</span>
        <span class="mono mt-1 text-[13px] font-medium">
          {x.labCta} <span class="jd-arrow">→</span>
        </span>
      </div>
    </a>
  </div>
</section>
