---
import type { Content } from '../i18n';
import T from './T.astro';
import SectionHeading from './SectionHeading.astro';
import Waveform from './Waveform.astro';

interface Props {
  x: Content['x'];
}
const { x } = Astro.props;
const mic =
  '<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/>';
const preview =
  'bg-bg dots border-line2 box-border flex flex-1 flex-col border-b p-3';
---

<section id="lab" class="border-line border-t py-section">
  <div>
    <SectionHeading n="02">
      <T v={x.labTitle} />
    </SectionHeading>
    <p class="mt-4 mb-0 text-h2 leading-none font-medium tracking-[-0.045em]">
      <T v={x.labA} />
      <span>
        <T v={x.labB} />
      </span>
    </p>
    <p class="text-body mt-3 mb-0 max-w-[560px] text-sm leading-[1.55]">
      <T v={x.labSub} />
    </p>
  </div>

  <div class="mt-head grid grid-cols-[repeat(auto-fit,minmax(min(420px,100%),1fr))] gap-4">
    <article class="bg-panel border-accent flex flex-col border">
      <div aria-hidden="true" class:list={[preview, 'gap-2.5']}>
        <div class="mono flex items-center justify-between gap-3 text-[10px] tracking-[0.08em] uppercase">
          <span class="text-accent flex items-center gap-2">
            <span class="bg-accent size-1.5"></span>
            <T v={x.agentSpeaking} />
          </span>
          <span class="text-muted">
            <T v={x.pvSim} /> · 00:42
          </span>
        </div>
        <Waveform variant="mini" />
        <div class="flex flex-col gap-1 text-[13px] leading-[1.4]">
          <div class="text-muted">
            <span class="mono mr-2 text-[10px] tracking-[0.08em] uppercase">
              <T v={x.pvYou} />
            </span>
            <T v={x.voiceUser} />
          </div>
          <div class="text-ink">
            <span class="mono text-accent mr-2 text-[10px] tracking-[0.08em] uppercase">
              <T v={x.pvAgent} />
            </span>
            <T v={x.voiceAgent} />
            <span class="bg-accent ml-[3px] inline-block h-3.5 w-[7px] align-[-2px]"></span>
          </div>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="mono text-chip flex flex-wrap gap-1.5 text-[10px]">
            {['STT', 'LLM', 'TTS'].map((k) => (
              <span class="border-line2 border px-2 py-1">{k}</span>
            ))}
          </div>
          <div class="flex gap-1.5">
            <span class="border-line2 text-ink grid size-7 place-items-center border">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={mic + '<path d="M12 19v3"/>'}
              />
            </span>
            <span class="bg-accent text-on-accent grid size-7 place-items-center">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <rect x="6" y="6" width="12" height="12"></rect>
              </svg>
            </span>
          </div>
        </div>
      </div>
      <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-1 px-3 py-2.5">
        <div class="flex min-w-0 flex-col gap-0.5">
          <span class="tag text-accent">
            <T v={x.lab1Tag} />
          </span>
          <span class="text-h3 font-medium tracking-[-0.03em]">
            Realtime Voice Lab
          </span>
          <span class="text-body text-[13px] leading-snug">
            <T v={x.lab1Body} />
          </span>
        </div>
        <span class="mono text-muted text-[12px]">
          <T v={x.labCta} />
        </span>
      </div>
    </article>

    <article class="bg-panel border-line2 flex flex-col border">
      <div aria-hidden="true" class:list={[preview, 'gap-2']}>
        <div class="mono flex items-center justify-between gap-3 text-[10px] tracking-[0.06em]">
          <span class="flex gap-1.5">
            <span class="border-line2 text-chip border px-2 py-1">
              Claude ▾
            </span>
            <span class="border-line2 text-muted border px-2 py-1">BYOK</span>
          </span>
          <span class="text-muted tracking-[0.08em] uppercase">
            <T v={x.pvSim} />
          </span>
        </div>
        <div class="flex max-w-[92%] items-center gap-2 self-end">
          <span class="mono border-line2 text-chip inline-flex items-center gap-1.5 border px-2 py-[5px] text-[10px]">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
            >
              <path d="M6 2h9l5 5v15H6z"></path>
              <path d="M14 2v6h6"></path>
            </svg>
            <T v={x.chatFile} />
          </span>
          <span class="bg-panel border-line2 text-ink border px-3 py-1.5 text-[13px] leading-[1.4]">
            <T v={x.chatUser} />
          </span>
        </div>
        <div class="border-line2 text-muted mono flex flex-wrap items-center gap-2 border border-dashed px-2.5 py-1 text-[11px]">
          <span class="text-accent">tool</span>
          <span>search_menu({'{ vegetarian: true }'})</span>
          <span class="text-chip ml-auto">
            ✓ <T v={x.toolResult} />
          </span>
        </div>
        <div class="border-accent text-ink border-l-2 px-3 py-1 text-[13px] leading-[1.4]">
          <T v={x.chatAgent} />
          <span class="bg-accent ml-[3px] inline-block h-3.5 w-[7px] align-[-2px]"></span>
        </div>
        <div class="border-line2 bg-panel text-muted mt-auto flex items-center gap-2.5 border py-1.5 pr-1.5 pl-3">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 11.5l-8.6 8.6a5 5 0 0 1-7.1-7.1l8.6-8.6a3.3 3.3 0 0 1 4.7 4.7l-8.6 8.6a1.7 1.7 0 0 1-2.4-2.4l8-8"></path>
          </svg>
          <span class="flex-auto text-[13px]">
            <T v={x.chatPlaceholder} />
          </span>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={mic}
          />
          <span class="bg-accent text-on-accent grid size-7 place-items-center">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 19V5M5 12l7-7 7 7"></path>
            </svg>
          </span>
        </div>
      </div>
      <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-1 px-3 py-2.5">
        <div class="flex min-w-0 flex-col gap-0.5">
          <span class="tag text-muted">
            <T v={x.lab2Tag} />
          </span>
          <span class="text-h3 font-medium tracking-[-0.03em]">
            Multimodal Chat
          </span>
          <span class="text-body text-[13px] leading-snug">
            <T v={x.lab2Body} />
          </span>
        </div>
        <span class="mono text-muted text-[12px]">
          <T v={x.labCta} />
        </span>
      </div>
    </article>
  </div>
</section>
