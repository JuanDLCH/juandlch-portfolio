---
// Bar heights/animation timings follow the design's formulas; animation is CSS-only.
interface Props {
  variant: 'hero' | 'mini';
}
const { variant } = Astro.props;
const hero = variant === 'hero';
const count = hero ? 64 : 40;
const bars = Array.from({ length: count }, (_, i) => {
  if (hero) {
    const user = i < 26;
    const gap = i >= 26 && i < 34;
    const env = user
      ? Math.sin((i / 26) * Math.PI)
      : Math.sin(((i - 34) / 30) * Math.PI);
    const wobble =
      0.55 + 0.45 * Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.6));
    const h = gap ? 2 : Math.max(4, Math.round(128 * env * wobble));
    const speaking = !user && !gap;
    return {
      h,
      color: user ? 'var(--user-bar)' : gap ? 'var(--line2)' : 'var(--accent)',
      anim: speaking
        ? `jd-wave ${(0.9 + (i % 5) * 0.12).toFixed(2)}s ease-in-out ${(-(i % 7) * 0.13).toFixed(2)}s infinite alternate`
        : 'none',
    };
  }
  const env = Math.sin((i / 39) * Math.PI);
  const wob = 0.5 + 0.5 * Math.abs(Math.sin(i * 2.1) * Math.cos(i * 0.7));
  return {
    h: Math.max(4, Math.round(64 * env * wob)),
    color: 'var(--accent)',
    anim: `jd-wave ${(0.8 + (i % 4) * 0.15).toFixed(2)}s ease-in-out ${(-(i % 6) * 0.11).toFixed(2)}s infinite alternate`,
  };
});
---

<div
  aria-hidden="true"
  class:list={[
    'flex items-center gap-[3px]',
    hero ? 'mt-[22px] h-[150px]' : 'h-[72px]',
  ]}
>
  {bars.map((b) => (
    <span
      class="jd-anim flex-[1_1_0]"
      style={`height:${b.h}px;background:${b.color};animation:${b.anim}`}
    />
  ))}
</div>
