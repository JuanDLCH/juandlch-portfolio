---
import Layout from '../layouts/Layout.astro';
import { getContent, pick } from '../i18n';
import { CONTACT } from '../lab/chat/contact';
import About from './About.astro';
import BackToTop from './BackToTop.astro';
import SophieDock from './SophieDock.astro';
import Certifications from './Certifications.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Lab from './Lab.astro';
import Leading from './Leading.astro';
import Principles from './Principles.astro';
import Rag from './Rag.astro';
import Stack from './Stack.astro';
import Work from './Work.astro';

const {
  x,
  cycle,
  cases,
  ragFlow,
  ragIdeas,
  awsIcons,
  domains,
  stackGroups,
  principles,
} = getContent();
---

<Layout
  title={{ en: pick(x.shareTitle, 'en'), es: pick(x.shareTitle, 'es') }}
  description={pick(x.shareDesc, 'en')}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Juan Diego Londoño',
    jobTitle: 'AI Engineer',
    url: 'https://juandlch.dev',
    email: `mailto:${CONTACT.email}`,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Medellín',
      addressCountry: 'CO',
    },
    sameAs: [CONTACT.linkedin, CONTACT.github],
  }}
>
  <Header x={x} />
  <div class="mx-auto max-w-[1200px] px-[clamp(16px,4vw,48px)]">
    <Hero x={x} />
    <Work x={x} cases={cases} />
    <Lab x={x} />
    <Rag x={x} flow={ragFlow} ideas={ragIdeas} />
    <Stack
      x={x}
      awsIcons={awsIcons}
      domains={domains}
      stackGroups={stackGroups}
    />
    <About x={x}>
      <Leading x={x} cycle={cycle} />
    </About>
    <Principles x={x} principles={principles} />
    <Certifications x={x} />
    <Footer x={x} />
  </div>
  <SophieDock x={x} />
  <BackToTop x={x} />
</Layout>
