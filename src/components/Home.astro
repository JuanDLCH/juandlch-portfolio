---
import Layout from '../layouts/Layout.astro';
import { getContent, type Lang } from '../i18n';
import About from './About.astro';
import Certifications from './Certifications.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Lab from './Lab.astro';
import Leading from './Leading.astro';
import Principles from './Principles.astro';
import Stack from './Stack.astro';
import Work from './Work.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { x, cycle, cases, awsIcons, domains, stackGroups, principles } =
  getContent(lang);
---

<Layout lang={lang} title="JuanDLCH — Signal" description={x.heroSub}>
  <Header x={x} lang={lang} />
  <div class="mx-auto max-w-[1320px] px-[clamp(16px,4vw,48px)]">
    <Hero x={x} />
    <About x={x} />
    <Leading x={x} cycle={cycle} />
    <Work x={x} cases={cases} />
    <Lab x={x} />
    <Stack
      x={x}
      awsIcons={awsIcons}
      domains={domains}
      stackGroups={stackGroups}
    />
    <Principles x={x} principles={principles} />
    <Certifications x={x} />
    <Footer x={x} />
  </div>
</Layout>
