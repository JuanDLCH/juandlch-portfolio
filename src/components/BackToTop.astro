---
// Floating "back to top" button, bottom right. Hidden (and inert, so Tab
// skips it) until the visitor scrolls past most of the first screen. A link
// to #top like the logo: smooth scrolling comes from global.css, which turns
// it off for reduced motion.
import { attrs, type Content } from '../i18n';

interface Props {
  x: Content['x'];
}
const { x } = Astro.props;
---

<a
  href="#top"
  data-back-to-top
  inert
  {...attrs({ 'aria-label': x.backToTop, title: x.backToTop })}
  class="bg-panel border-line2 text-ink hover:border-accent hover:text-accent pointer-events-none fixed right-[clamp(16px,3vw,32px)] bottom-[calc(clamp(16px,3vw,32px)+env(safe-area-inset-bottom))] z-40 grid size-11 translate-y-2 place-items-center border opacity-0 shadow-[0_12px_32px_-16px_var(--accent)] transition-[opacity,translate,border-color,color] duration-200 data-shown:pointer-events-auto data-shown:translate-y-0 data-shown:opacity-100 motion-reduce:transition-none"
>
  <svg
    aria-hidden="true"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 19V5M5 12l7-7 7 7"></path>
  </svg>
</a>

<script>
  let teardown: (() => void) | undefined;
  document.addEventListener('astro:before-swap', () => teardown?.());
  document.addEventListener('astro:page-load', () => {
    const btn = document.querySelector<HTMLAnchorElement>('[data-back-to-top]');
    if (!btn) return;
    const update = () => {
      const shown = scrollY > innerHeight * 0.8;
      btn.toggleAttribute('data-shown', shown);
      btn.inert = !shown;
    };
    update();
    addEventListener('scroll', update, { passive: true });
    teardown = () => removeEventListener('scroll', update);
  });
</script>
