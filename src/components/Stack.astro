---
import type { Content } from '../i18n';
import CornerMarks from './CornerMarks.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  x: Content['x'];
  awsIcons: Content['awsIcons'];
  domains: Content['domains'];
  stackGroups: Content['stackGroups'];
}
const { x, awsIcons, domains, stackGroups } = Astro.props;

// Hashed, cacheable URLs for every SVG in src/assets/aws.
const iconUrls = import.meta.glob<string>('../assets/aws/*.svg', {
  eager: true,
  query: '?url',
  import: 'default',
});
const iconUrl = (name: string) => iconUrls[`../assets/aws/${name}.svg`];
---

<section id="stack" class="border-line border-t py-[88px]">
  <SectionHeading n="05">{x.stackTitle}</SectionHeading>

  <div class="bg-panel border-line2 relative mt-8 flex flex-wrap gap-x-14 gap-y-10 border p-[clamp(24px,3vw,40px)]">
    <CornerMarks only={['tl']} />
    <CornerMarks only={['br']} />
    <div class="min-w-0 flex-[1_1_440px]">
      <div class="eyebrow text-accent">{x.awsTag}</div>
      <p class="mt-[18px] mb-0 text-[clamp(26px,2.6vw,36px)] leading-[1.15] font-medium tracking-[-0.035em] text-balance">
        {x.awsLeadA}
        <span class="text-accent">Amazon Bedrock</span>
        {x.awsLeadB}
      </p>
      <p class="text-body mt-[18px] mb-0 max-w-[560px] text-base leading-[1.6]">
        {x.awsBody}
      </p>
      <p class="border-line2 m-0 mt-[22px] flex max-w-[560px] items-start gap-3 border-t pt-[18px] text-[17px] leading-normal font-medium">
        <span aria-hidden="true" class="bg-accent mt-2 size-2 flex-none"></span>
        <span>{x.awsFlex}</span>
      </p>
    </div>
    <ul
      aria-label={x.awsIconsLabel}
      class="m-0 min-w-0 flex-[1_1_400px] list-none self-center p-0 grid grid-cols-[repeat(auto-fill,minmax(84px,1fr))] gap-x-3 gap-y-[22px]"
    >
      {awsIcons.map((ic) => (
        <li class="jd-aws flex flex-col items-center gap-2.5 text-center">
          <img
            src={iconUrl(ic.icon)}
            alt=""
            width="44"
            height="44"
            loading="lazy"
            decoding="async"
            class="size-11"
          />
          <span class="mono text-muted text-[10px] leading-[1.3] tracking-[0.02em]">
            {ic.name}
          </span>
        </li>
      ))}
    </ul>
  </div>

  <div class="border-line mt-6 grid grid-cols-[repeat(auto-fit,minmax(min(200px,100%),1fr))] border-t border-l">
    {domains.map((d) => (
      <div class="bg-bg border-line border-r border-b px-5 py-[22px]">
        <h3 class="m-0 text-lg leading-[1.2] font-medium tracking-[-0.02em]">
          {d.title}
        </h3>
        <p class="text-body mt-2 mb-0 text-sm leading-normal">{d.body}</p>
        <p class="mono text-accent mt-3.5 mb-0 text-[11px] leading-[1.7]">
          {d.tools}
        </p>
      </div>
    ))}
  </div>

  <details class="jd-details border-line2 mt-6 border-y">
    <summary class="mono flex min-h-14 items-center justify-between gap-3 text-xs tracking-[0.08em] uppercase">
      <span>{x.toolboxLabel}</span>
      <span class="jd-plus text-accent text-xl" aria-hidden="true">
        +
      </span>
    </summary>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(280px,100%),1fr))] gap-x-10 gap-y-7 pt-2 pb-8">
      {stackGroups.map((g) => (
        <div>
          <h4 class="border-line m-0 mb-3 border-b pb-2 text-[15px] font-medium">
            {g.title}
          </h4>
          <p class="mono text-chip m-0 text-xs leading-[1.8]">{g.items}</p>
        </div>
      ))}
    </div>
  </details>
</section>
