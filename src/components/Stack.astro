---
import type { Content } from '../i18n';
import CornerMarks from './CornerMarks.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  x: Content['x'];
  awsIcons: Content['awsIcons'];
  domains: Content['domains'];
  stackGroups: Content['stackGroups'];
}
const { x, awsIcons, domains, stackGroups } = Astro.props;

// Hashed, cacheable URLs for every SVG in src/assets/aws.
const iconUrls = import.meta.glob<string>('../assets/aws/*.svg', {
  eager: true,
  query: '?url',
  import: 'default',
});
const iconUrl = (name: string) => iconUrls[`../assets/aws/${name}.svg`];
---

<section id="stack" class="border-line border-t py-section">
  <SectionHeading n="05">{x.stackTitle}</SectionHeading>

  <div class="bg-panel border-line2 relative mt-block flex flex-wrap gap-x-gutter gap-y-6 border p-block">
    <CornerMarks only={['tl']} />
    <CornerMarks only={['br']} />
    <div class="min-w-0 flex-[1_1_440px]">
      <div class="eyebrow text-accent">{x.awsTag}</div>
      <p class="mt-3 mb-0 text-[clamp(18px,1.8vw,26px)] leading-[1.15] font-medium tracking-[-0.035em] text-balance">
        {x.awsLeadA}
        <span class="text-accent">Amazon Bedrock</span>
        {x.awsLeadB}
      </p>
      <p class="text-body mt-3 mb-0 max-w-[560px] text-sm leading-[1.55]">
        {x.awsBody}
      </p>
      <p class="border-line2 m-0 mt-stack flex max-w-[560px] items-start gap-3 border-t pt-3 text-sm leading-normal font-medium">
        <span aria-hidden="true" class="bg-accent mt-2 size-2 flex-none"></span>
        <span>{x.awsFlex}</span>
      </p>
    </div>
    <ul
      aria-label={x.awsIconsLabel}
      class="m-0 min-w-0 flex-[1_1_400px] list-none self-center p-0 grid grid-cols-[repeat(auto-fill,minmax(56px,1fr))] gap-x-1.5 gap-y-2.5"
    >
      {awsIcons.map((ic) => (
        <li class="jd-aws flex flex-col items-center gap-1.5 text-center">
          <img
            src={iconUrl(ic.icon)}
            alt=""
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
            class="size-icon"
          />
          <span class="mono text-muted text-[10px] leading-[1.3] tracking-[0.02em]">
            {ic.name}
          </span>
        </li>
      ))}
    </ul>
  </div>

  <div class="border-line mt-4 grid grid-cols-[repeat(auto-fit,minmax(min(180px,100%),1fr))] border-t border-l">
    {domains.map((d) => (
      <div class="bg-bg border-line border-r border-b p-card">
        <h3 class="m-0 text-[15px] leading-[1.2] font-medium tracking-[-0.02em]">
          {d.title}
        </h3>
        <p class="text-body mt-1.5 mb-0 text-[12.5px] leading-[1.45] [@media(max-height:700px)]:hidden">
          {d.body}
        </p>
        <p class="mono text-accent mt-3.5 mb-0 text-[11px] leading-[1.7]">
          {d.tools}
        </p>
      </div>
    ))}
  </div>

  <details class="jd-details group border-line2 bg-panel hover:border-accent open:border-accent mt-4 border transition-colors">
    <summary class="flex min-h-12 items-center justify-between gap-3 px-card py-2">
      <span class="flex items-center gap-3">
        <span class="mono text-ink text-[13px] font-semibold tracking-[0.08em] uppercase">
          {x.toolboxLabel}
        </span>
        <span class="mono border-line2 text-muted border px-1.5 py-0.5 text-[10px]">
          {stackGroups.length}
        </span>
      </span>
      <span
        class="border-accent text-accent group-hover:bg-accent group-hover:text-on-accent grid size-8 place-items-center border transition-colors"
        aria-hidden="true"
      >
        <span class="jd-plus text-xl leading-none">+</span>
      </span>
    </summary>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(240px,100%),1fr))] gap-x-10 gap-y-6 px-card pt-2 pb-card">
      {stackGroups.map((g) => (
        <div>
          <h4 class="border-line m-0 mb-3 border-b pb-2 text-[15px] font-medium">
            {g.title}
          </h4>
          <p class="mono text-chip m-0 text-xs leading-[1.8]">{g.items}</p>
        </div>
      ))}
    </div>
  </details>
</section>
