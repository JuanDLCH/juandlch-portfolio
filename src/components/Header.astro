---
import { attrs, pick, type Content } from '../i18n';
import T from './T.astro';
import ThemeToggle from './ThemeToggle';

interface Props {
  x: Content['x'];
}
const { x } = Astro.props;
// Each link stays active across the sections it groups.
const links = [
  { href: '#work', label: x.navWork, sections: 'work' },
  { href: '#lab', label: x.navLab, sections: 'lab' },
  { href: '#rag', label: x.navExpertise, sections: 'rag stack' },
  {
    href: '#about',
    label: x.navAbout,
    sections: 'about principles certifications',
  },
  { href: '#contact', label: x.navContact, sections: 'contact' },
];
// Active state comes from <html data-lang>, so it is right before any JS runs.
const langBtn =
  'text-ink grid h-9 w-10 cursor-pointer place-items-center border-0 bg-transparent p-0 font-[inherit] text-xs font-medium tracking-[0.06em]';
---

<header class="border-line bg-bg/85 sticky top-0 z-50 border-b backdrop-blur-md">
  <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-x-4 gap-y-1 px-[clamp(16px,4vw,48px)] py-2">
    <a
      href="#top"
      class="mono order-1 flex items-center gap-2.5 text-[15px] font-medium tracking-[0.04em] no-underline"
    >
      <span
        aria-hidden="true"
        class="border-accent grid size-3.5 place-items-center border-[1.5px]"
      >
        <span class="bg-accent size-1"></span>
      </span>
      JUANDLCH
    </a>
    <nav
      {...attrs({ 'aria-label': x.navLabel })}
      class="mono order-3 -mx-1 flex w-full items-center gap-1 overflow-x-auto px-1 text-[13px] tracking-[0.06em] uppercase [scrollbar-width:none] sm:order-2 sm:mx-0 sm:ml-auto sm:w-auto sm:overflow-visible sm:px-0"
    >
      {links.map(({ href, label, sections }) => (
        <a
          href={href}
          data-nav-link
          data-sections={sections}
          class="px-3 py-2 whitespace-nowrap no-underline aria-[current=true]:text-accent"
        >
          <T v={label} />
        </a>
      ))}
    </nav>
    <div class="mono order-2 ml-auto flex items-center gap-2 text-[13px] tracking-[0.06em] uppercase sm:order-3 sm:ml-2">
      <a
        href="#cv"
        class="border-line2 border px-3.5 py-2 whitespace-nowrap no-underline"
      >
        <T v={x.navCv} />
      </a>
      <div
        role="group"
        {...attrs({ 'aria-label': x.langGroup })}
        class="border-line2 flex border"
      >
        <button
          type="button"
          data-set-lang="en"
          aria-pressed="true"
          class:list={[
            langBtn,
            '[html[data-lang=en]_&]:bg-ink [html[data-lang=en]_&]:text-bg',
          ]}
        >
          EN
        </button>
        <button
          type="button"
          data-set-lang="es"
          aria-pressed="false"
          class:list={[
            langBtn,
            'border-line2 border-l [html[data-lang=es]_&]:bg-ink [html[data-lang=es]_&]:text-bg',
          ]}
        >
          ES
        </button>
      </div>
      <ThemeToggle
        client:load
        toLight={{ en: pick(x.toLight, 'en'), es: pick(x.toLight, 'es') }}
        toDark={{ en: pick(x.toDark, 'en'), es: pick(x.toDark, 'es') }}
      />
    </div>
  </div>
</header>

<script>
  // Highlight the nav link whose group contains the section in view.
  const linkFor = new Map<string, HTMLAnchorElement>();
  document
    .querySelectorAll<HTMLAnchorElement>('[data-nav-link]')
    .forEach((a) =>
      (a.dataset.sections ?? '').split(' ').forEach((id) => linkFor.set(id, a)),
    );

  const sections = [...linkFor.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null)
    .sort((a, b) =>
      a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1,
    );
  const visible = new Set<string>();

  const paint = () => {
    // Last visible section in document order wins; at the very bottom the
    // short footer can't reach the middle band, so it wins there.
    const atEnd =
      innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
    const current = atEnd
      ? sections[sections.length - 1]
      : sections.filter((el) => visible.has(el.id)).pop();
    const active = current ? linkFor.get(current.id) : undefined;
    linkFor.forEach((a) =>
      a.setAttribute('aria-current', String(a === active)),
    );
  };

  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) =>
        e.isIntersecting
          ? visible.add(e.target.id)
          : visible.delete(e.target.id),
      );
      paint();
    },
    { rootMargin: '-35% 0px -55% 0px' },
  );
  sections.forEach((el) => io.observe(el));
  addEventListener('scroll', paint, { passive: true });
</script>
