---
import type { Content, Lang } from '../i18n';
import ThemeToggle from './ThemeToggle';

interface Props {
  x: Content['x'];
  lang: Lang;
}
const { x, lang } = Astro.props;
const links = [
  ['#work', x.navWork],
  ['#lab', x.navLab],
  ['#about', x.navAbout],
  ['#contact', x.navContact],
];
const langBtn =
  'grid h-9 w-10 place-items-center text-xs font-medium tracking-[0.06em] no-underline hover:!text-current';
---

<header class="border-line bg-bg/85 sticky top-0 z-50 border-b backdrop-blur-md">
  <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-x-4 gap-y-1 px-[clamp(16px,4vw,48px)] py-2">
    <a
      href="#top"
      class="mono flex items-center gap-2.5 text-[15px] font-medium tracking-[0.04em] no-underline"
    >
      <span
        aria-hidden="true"
        class="border-accent grid size-3.5 place-items-center border-[1.5px]"
      >
        <span class="bg-accent size-1"></span>
      </span>
      JUANDLCH
    </a>
    <nav
      aria-label={x.navLabel}
      class="mono -mx-1 flex w-full items-center gap-1 overflow-x-auto px-1 text-[13px] tracking-[0.06em] uppercase [scrollbar-width:none] sm:mx-0 sm:w-auto sm:flex-wrap sm:overflow-visible sm:px-0"
    >
      {links.map(([href, label]) => (
        <a
          href={href}
          data-nav-link
          class="px-3 py-2 whitespace-nowrap no-underline aria-[current=true]:text-accent"
        >
          {label}
        </a>
      ))}
      <a href="#cv" class="border-line2 ml-2 border px-3.5 py-2 no-underline">
        {x.navCv}
      </a>
      <div
        role="group"
        aria-label={x.langGroup}
        class="border-line2 mono ml-2 flex border"
      >
        <a
          href="/en/"
          hreflang="en"
          aria-current={lang === 'en' ? 'true' : undefined}
          class:list={[langBtn, lang === 'en' ? 'bg-ink !text-bg' : 'text-ink']}
        >
          EN
        </a>
        <a
          href="/es/"
          hreflang="es"
          aria-current={lang === 'es' ? 'true' : undefined}
          class:list={[
            langBtn,
            'border-line2 border-l',
            lang === 'es' ? 'bg-ink !text-bg' : 'text-ink',
          ]}
        >
          ES
        </a>
      </div>
      <ThemeToggle client:load toLight={x.toLight} toDark={x.toDark} />
    </nav>
  </div>
</header>

<script>
  // Highlight the nav link of the section currently in view.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const byId = new Map<string, HTMLAnchorElement>();
  links.forEach((a) => byId.set(a.hash.slice(1), a));
  const visible = new Set<string>();

  const paint = () => {
    // Last visible section in document order wins.
    const ids = [...byId.keys()].filter((id) => visible.has(id));
    const current = ids[ids.length - 1];
    byId.forEach((a, id) =>
      a.setAttribute('aria-current', String(id === current)),
    );
  };

  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) =>
        e.isIntersecting
          ? visible.add(e.target.id)
          : visible.delete(e.target.id),
      );
      paint();
    },
    { rootMargin: '-35% 0px -55% 0px' },
  );
  const sections = [...byId.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);
  sections.sort((a, b) =>
    a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1,
  );
  sections.forEach((el) => io.observe(el));
</script>
