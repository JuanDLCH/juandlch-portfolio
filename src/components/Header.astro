---
import { attrs, pick, type Content } from '../i18n';
import T from './T.astro';
import ThemeToggle from './ThemeToggle';

interface Props {
  x: Content['x'];
}
const { x } = Astro.props;
// Each link stays active across the sections it groups.
const links = [
  { href: '#work', label: x.navWork, sections: 'work' },
  { href: '#lab', label: x.navLab, sections: 'lab' },
  { href: '#rag', label: x.navExpertise, sections: 'rag stack' },
  {
    href: '#about',
    label: x.navAbout,
    sections: 'about principles certifications',
  },
  { href: '#contact', label: x.navContact, sections: 'contact' },
];
// Active state comes from <html data-lang>, so it is right before any JS runs.
const langBtn =
  'text-ink grid h-9 w-10 cursor-pointer place-items-center border-0 bg-transparent p-0 font-[inherit] text-xs font-medium tracking-[0.06em]';
---

<header class="border-line bg-bg/85 sticky top-0 z-50 border-b backdrop-blur-md">
  <div class="mx-auto flex max-w-[1200px] items-center justify-between gap-x-4 px-[clamp(16px,4vw,48px)] py-2 narrow:gap-x-3">
    <a
      href="#top"
      class="mono flex items-center gap-2.5 text-[15px] font-medium tracking-[0.04em] no-underline"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-accent size-[18px]"
      >
        <path d="M8 7 3 12l5 5M16 7l5 5-5 5M14 4l-4 16" />
      </svg>
      JUANDLCH
    </a>
    <nav
      {...attrs({ 'aria-label': x.navLabel })}
      class="mono ml-auto flex items-center gap-1 text-[13px] tracking-[0.06em] uppercase narrow:gap-0 narrow:text-xs narrow:tracking-[0.03em] mob:hidden"
    >
      {links.map(({ href, label, sections }) => (
        <a
          href={href}
          data-nav-link
          data-sections={sections}
          class="px-3 py-2 whitespace-nowrap no-underline narrow:px-1.5 aria-[current=true]:text-accent"
        >
          <T v={label} />
        </a>
      ))}
    </nav>
    <div class="mono ml-2 flex items-center gap-2 text-[13px] tracking-[0.06em] uppercase narrow:ml-1 narrow:gap-1.5 narrow:text-xs mob:ml-auto">
      <a
        href="#cv"
        class="border-line2 border px-3.5 py-2 whitespace-nowrap no-underline narrow:px-2.5 mob:hidden"
      >
        <T v={x.navCv} />
      </a>
      <div
        role="group"
        {...attrs({ 'aria-label': x.langGroup })}
        class="border-line2 flex border"
      >
        <button
          type="button"
          data-set-lang="en"
          aria-pressed="true"
          class:list={[
            langBtn,
            '[html[data-lang=en]_&]:bg-ink [html[data-lang=en]_&]:text-bg',
          ]}
        >
          EN
        </button>
        <button
          type="button"
          data-set-lang="es"
          aria-pressed="false"
          class:list={[
            langBtn,
            'border-line2 border-l [html[data-lang=es]_&]:bg-ink [html[data-lang=es]_&]:text-bg',
          ]}
        >
          ES
        </button>
      </div>
      <ThemeToggle
        client:load
        toLight={{ en: pick(x.toLight, 'en'), es: pick(x.toLight, 'es') }}
        toDark={{ en: pick(x.toDark, 'en'), es: pick(x.toDark, 'es') }}
      />
      <button
        type="button"
        data-menu-open
        aria-haspopup="dialog"
        aria-expanded="false"
        {...attrs({ 'aria-label': x.menu })}
        class="border-line2 text-ink hidden size-11 cursor-pointer place-items-center border bg-transparent p-0 mob:grid"
      >
        <svg
          aria-hidden="true"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="square"
        >
          <path d="M4 7h16M4 12h16M4 17h10"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<dialog
  data-menu
  {...attrs({ 'aria-label': x.menu })}
  class="jd-menu m-0 h-dvh max-h-none w-full max-w-none p-0"
>
  <div class="flex h-full flex-col px-[clamp(16px,4vw,48px)] pt-2 pb-[calc(24px+env(safe-area-inset-bottom))]">
    <div class="border-line flex min-h-[52px] shrink-0 items-center justify-between border-b">
      <span class="mono flex items-center gap-2.5 text-[15px] font-medium tracking-[0.04em]">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-accent size-[18px]"
        >
          <path d="M8 7 3 12l5 5M16 7l5 5-5 5M14 4l-4 16" />
        </svg>
        JUANDLCH
      </span>
      <button
        type="button"
        data-menu-close
        {...attrs({ 'aria-label': x.close })}
        class="border-line2 text-ink grid size-11 cursor-pointer place-items-center border bg-transparent p-0 text-[22px]"
      >
        ×
      </button>
    </div>
    <nav
      {...attrs({ 'aria-label': x.navLabel })}
      class="mt-4 mb-4 flex min-h-0 flex-1 flex-col overflow-y-auto"
    >
      {links.map(({ href, label }, i) => (
        <a
          href={href}
          data-menu-link
          class="border-line flex min-h-14 shrink-0 items-baseline gap-4 border-b py-3.5 text-[clamp(22px,7vw,28px)] font-medium tracking-[-0.03em] no-underline"
        >
          <span class="mono text-accent text-xs tracking-[0.06em]">
            0{i + 1}
          </span>
          <T v={label} />
        </a>
      ))}
    </nav>
    <a
      href="#cv"
      data-menu-link
      class="mono border-line2 flex min-h-[52px] shrink-0 items-center justify-center border text-[13px] tracking-[0.06em] uppercase no-underline"
    >
      <T v={x.navCv} />
    </a>
  </div>
</dialog>

<script>
  // Runs on every page view (ClientRouter keeps this module loaded); the
  // previous page's observer and scroll listener are torn down on swap.
  let teardown: (() => void) | undefined;
  document.addEventListener('astro:before-swap', () => teardown?.());
  document.addEventListener('astro:page-load', () => {
    // Mobile menu: a native modal <dialog> (Esc and focus handling for free).
    const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
    const openBtn =
      document.querySelector<HTMLButtonElement>('[data-menu-open]');
    openBtn?.addEventListener('click', () => {
      menu?.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
    });
    menu?.addEventListener('close', () =>
      openBtn?.setAttribute('aria-expanded', 'false'),
    );
    menu
      ?.querySelectorAll('[data-menu-close], [data-menu-link]')
      .forEach((el) => el.addEventListener('click', () => menu.close()));

    // Highlight the nav link whose group contains the section in view.
    const linkFor = new Map<string, HTMLAnchorElement>();
    document
      .querySelectorAll<HTMLAnchorElement>('[data-nav-link]')
      .forEach((a) =>
        (a.dataset.sections ?? '')
          .split(' ')
          .forEach((id) => linkFor.set(id, a)),
      );

    const sections = [...linkFor.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null)
      .sort((a, b) =>
        a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING
          ? -1
          : 1,
      );
    const visible = new Set<string>();

    const paint = () => {
      // Last visible section in document order wins; at the very bottom the
      // short footer can't reach the middle band, so it wins there.
      const atEnd =
        innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
      const current = atEnd
        ? sections[sections.length - 1]
        : sections.filter((el) => visible.has(el.id)).pop();
      const active = current ? linkFor.get(current.id) : undefined;
      linkFor.forEach((a) =>
        a.setAttribute('aria-current', String(a === active)),
      );
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) =>
          e.isIntersecting
            ? visible.add(e.target.id)
            : visible.delete(e.target.id),
        );
        paint();
      },
      { rootMargin: '-35% 0px -55% 0px' },
    );
    sections.forEach((el) => io.observe(el));
    addEventListener('scroll', paint, { passive: true });
    teardown = () => {
      io.disconnect();
      removeEventListener('scroll', paint);
    };
  });
</script>
