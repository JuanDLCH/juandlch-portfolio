---
import { CONTACT } from '../lab/chat/contact';
import { Image } from 'astro:assets';
import T from './T.astro';
import { attrs, type Content } from '../i18n';
import photo from '../assets/photo.png';
import CornerMarks from './CornerMarks.astro';
import Waveform from './Waveform.astro';

interface Props {
  x: Content['x'];
}
const { x } = Astro.props;
const stages = [
  [x.stUser, x.stSpeech],
  ['STT', x.stStt],
  [x.stAgent, x.stReason],
  [x.stTool, 'get_menu()'],
];
---

<section id="top" class="pt-block pb-section">
  <div class="flex flex-wrap items-end gap-x-gutter gap-y-6 narrow:items-start mob:grid mob:grid-cols-[auto_minmax(0,1fr)] mob:items-end mob:gap-x-4 mob:gap-y-3.5">
    <div class="jd-rise relative aspect-[4/5] w-photo flex-none mob:col-start-1 mob:row-span-2 mob:row-start-1 mob:w-[clamp(72px,24vw,112px)]">
      <Image
        src={photo}
        {...attrs({ alt: x.photoAlt })}
        width={340}
        height={425}
        widths={[170, 255, 340]}
        sizes="170px"
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
        class="border-line2 size-full border object-cover"
      />
      <CornerMarks offset="-8px" size="22px" />
    </div>
    <div class="jd-rise flex min-w-0 flex-[1_1_560px] flex-col gap-stack [animation-delay:0.12s] narrow:flex-[1_1_360px] mob:contents">
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3.5 narrow:contents">
        <div class="flex min-w-0 flex-auto flex-col gap-stack mob:contents">
          <h1 class="m-0 text-display leading-[0.95] font-medium tracking-[-0.055em] mob:col-start-2 mob:row-start-1 mob:text-[clamp(26px,8.5vw,38px)] mob:leading-none">
            Juan Diego Londoño
          </h1>
          <div class="mono text-accent flex items-center gap-3 text-[13px] tracking-[0.1em] uppercase mob:col-start-2 mob:row-start-2 mob:self-start mob:text-[11px] mob:tracking-[0.08em]">
            <span
              aria-hidden="true"
              class="bg-accent h-px w-8 mob:hidden"
            ></span>
            <T v={x.role} />
          </div>
        </div>
        <div class="flex flex-none flex-col gap-2 narrow:order-last narrow:flex-row narrow:flex-wrap mob:order-10 mob:flex-col mob:col-span-full mob:mt-1">
          <a
            href="/lab/cv"
            class="jd-cvbtn jd-fill bg-accent !text-on-accent inline-flex min-h-10 items-center justify-center gap-2 px-4 text-sm font-semibold mob:min-h-12 mob:text-[15px] whitespace-nowrap no-underline"
          >
            <svg
              aria-hidden="true"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="4" y="8" width="16" height="12"></rect>
              <path d="M12 8V4"></path>
              <circle cx="12" cy="3" r="1"></circle>
              <path class="jd-eyes" d="M9 13v1.5M15 13v1.5"></path>
              <path d="M9.5 17.5h5"></path>
              <path d="M2 12v4M22 12v4"></path>
            </svg>
            <T v={x.talkCv} />
          </a>
          <a
            href={CONTACT.booking ?? '#contact'}
            target="_blank"
            rel="noopener noreferrer"
            class="jd-card border-accent text-accent inline-flex min-h-9 items-center justify-center gap-2 border px-4 text-[13px] font-medium mob:min-h-11 mob:text-sm whitespace-nowrap no-underline"
          >
            <svg
              aria-hidden="true"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
            >
              <rect x="3" y="5" width="18" height="16"></rect>
              <path d="M3 10h18M8 3v4M16 3v4"></path>
              <path d="M8 14h3v3H8z"></path>
            </svg>
            <T v={x.bookCall} />
          </a>
        </div>
      </div>
      <div class="border-line2 flex flex-wrap items-center gap-x-7 gap-y-3.5 border-t pt-stack mob:col-span-full">
        <span class="flex items-center gap-3 text-lg mob:text-[15px]">
          <span
            aria-hidden="true"
            class="border-line2 flex h-[22px] w-[33px] flex-col border"
          >
            <span class="flex-[2_1_0] bg-[#FCD116]"></span>
            <span class="flex-[1_1_0] bg-[#003893]"></span>
            <span class="flex-[1_1_0] bg-[#CE1126]"></span>
          </span>
          Medellín, Colombia
        </span>
        <span
          aria-hidden="true"
          class="bg-line2 hidden h-[22px] w-px sm:block narrow:hidden"
        ></span>
        <span class="mono flex flex-wrap items-center gap-2 text-xs tracking-[0.04em]">
          <span class="border-line2 text-chip border px-[11px] py-[7px]">
            <T v={x.langEs} />
          </span>
          <span class="border-line2 text-chip border px-[11px] py-[7px]">
            <T v={x.langEn} />
          </span>
        </span>
      </div>
      <div class="-mt-2.5 flex items-start gap-3.5 text-lg mob:col-span-full mob:mt-0 mob:text-[15px]">
        <svg
          aria-hidden="true"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="var(--accent)"
          stroke-width="1.5"
          stroke-linejoin="round"
          class="mt-0.5 flex-none"
        >
          <path d="M2 9l10-5 10 5-10 5-10-5z"></path>
          <path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"></path>
          <path d="M22 9v6"></path>
        </svg>
        <span class="flex flex-wrap items-baseline gap-x-3.5 gap-y-1">
          <span>
            <T v={x.degree} /> · Universidad de Medellín
          </span>
          <span class="mono text-muted text-xs tracking-[0.06em]">
            <T v={x.degreeMeta} />
          </span>
        </span>
      </div>
    </div>
  </div>

  <div class="border-line2 mt-block flex flex-wrap items-center gap-gutter border-t pt-block">
    <div class="min-w-0 flex-[1_1_520px]">
      <p class="m-0 text-hero leading-[1.08] font-medium tracking-[-0.04em] text-balance mob:text-[clamp(19px,5.6vw,22px)] mob:leading-[1.15]">
        <T v={x.heroA} />
        <span class="text-accent">
          <T v={x.heroB} />
        </span>
        <T v={x.heroC} />
      </p>
      <p class="text-body mt-stack mb-0 max-w-[560px] text-sub leading-[1.55] font-light text-pretty">
        <T v={x.heroSub} />
      </p>
      <div class="mt-block flex flex-wrap gap-3">
        <a
          href="#work"
          class="jd-fill bg-accent !text-on-accent inline-flex min-h-[44px] items-center gap-2.5 px-6 text-[15px] font-semibold no-underline mob:flex-[1_1_100%] mob:justify-center"
        >
          <T v={x.ctaWork} />{' '}
          <span class="jd-arrow" aria-hidden="true">
            ↓
          </span>
        </a>
        <a
          href="#lab"
          class="jd-card border-line2 inline-flex min-h-[44px] items-center gap-3 border px-6 text-[15px] font-medium no-underline mob:flex-[1_1_100%] mob:justify-center"
        >
          <svg
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"></path>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
            <path d="M12 19v3"></path>
          </svg>
          <T v={x.ctaLab} />
        </a>
      </div>
    </div>

    <figure class="jd-rise bg-panel dots border-line relative m-0 min-w-0 flex-[1_1_500px] border p-card [animation-delay:0.3s]">
      <CornerMarks />
      <div class="eyebrow text-muted flex flex-wrap justify-between gap-3 !text-[11px]">
        <span class="flex items-center gap-2">
          <span class="jd-blink bg-accent size-1.5" aria-hidden="true"></span>
          <span class="text-accent">
            <T v={x.agentSpeaking} />
          </span>
        </span>
        <span>
          <T v={x.turnLabel} />
        </span>
      </div>
      <Waveform variant="hero" />
      <div
        aria-hidden="true"
        class="mono border-line2 text-muted mt-2.5 flex justify-between border-t pt-1.5 text-[10px] [@media(max-height:700px)]:hidden"
      >
        {['0.0s', '0.5', '1.0', '1.5', '2.0', '2.5', '3.0'].map((s) => (
          <span>{s}</span>
        ))}
      </div>
      <div class="mono mt-stack grid grid-cols-3 gap-1.5 text-[10px] tracking-[0.02em] desk:grid-cols-5">
        {stages.map(([a, b]) => (
          <div class="border-line2 text-chip min-w-0 border px-2 py-2.5 break-words">
            <T v={a} />
            <br />
            <span class="text-muted">
              <T v={b} />
            </span>
          </div>
        ))}
        <div class="border-accent text-accent min-w-0 border px-2 py-2.5 break-words">
          TTS
          <br />
          <span>streaming</span>
        </div>
      </div>
      <figcaption class="border-line text-muted mt-stack border-t pt-3 text-sm leading-[1.55]">
        <T v={x.figCaption} />
      </figcaption>
    </figure>
  </div>
</section>
