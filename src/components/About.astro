---
import type { Content } from '../i18n';
import T from './T.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  /** Section number (the services landing orders them differently). */
  n?: string;
  x: Content['x'];
}
const { x, n = '05' } = Astro.props;
// One step per role, start year only. The big title says what he was
// building; the role and company sit on a small line under it.
const steps = [
  {
    year: '2022',
    title: x.tl1t,
    role: 'Full Stack · Stellion Tech',
    text: x.tl1,
    tone: 'dim',
  },
  {
    year: '2023',
    title: x.tl2t,
    role: 'Full Stack · Trade EC',
    text: x.tl2,
    tone: 'dim',
  },
  {
    year: '2024',
    title: x.tl3t,
    role: 'Lead AI Engineer · Trade EC',
    text: x.tl3,
    tone: 'mid',
  },
  {
    year: '2026',
    title: x.tl4t,
    role: 'AI Engineer',
    text: x.tl4,
    tone: 'accent',
    now: true,
  },
] as const;
const border = {
  dim: 'border-line2',
  mid: 'border-mid',
  accent: 'border-accent',
};
const fill = { dim: 'bg-dim', mid: 'bg-mid', accent: 'bg-accent' };
---

<section id="about" class="border-line border-t py-section">
  <div>
    <SectionHeading n={n}>
      <T v={x.aboutTitle} />
    </SectionHeading>
    <p class="mt-4 mb-0 max-w-[880px] text-lead leading-[1.38] font-light tracking-[-0.015em] text-pretty">
      <T v={x.aboutA} />
      <span class="font-normal">
        <T v={x.aboutB} />
      </span>
      <T v={x.aboutC} />
    </p>
  </div>
  <ol class="m-0 mt-[calc(var(--spacing-head)*1.4)] grid list-none grid-cols-[repeat(auto-fit,minmax(min(200px,100%),1fr))] p-0 mob:grid-cols-1">
    {steps.map((s) => (
      <li
        class:list={[
          'relative border-t pt-5 pr-6 mob:border-t-0 mob:border-l mob:pt-0 mob:pr-0 mob:pb-[22px] mob:pl-[22px]',
          border[s.tone],
        ]}
      >
        <span
          aria-hidden="true"
          class:list={[
            'absolute -top-1 left-0 size-[7px] mob:top-[3px] mob:-left-1',
            fill[s.tone],
          ]}
        ></span>
        <div
          class:list={[
            'mono text-xs',
            s.tone === 'accent' ? 'text-accent' : 'text-muted',
          ]}
        >
          <T v={s.year} />
          {'now' in s && (
            <span class="border-accent text-accent ml-2 border px-1.5 py-px text-[10px] tracking-[0.12em] uppercase">
              <T v={x.tlNow} />
            </span>
          )}
        </div>
        <div class="mt-2.5 text-h3 font-medium tracking-[-0.02em]">
          <T v={s.title} />
        </div>
        <div class="mono text-muted mt-1.5 text-[11px] tracking-[0.08em] uppercase">
          {s.role}
        </div>
        <div class="text-muted mt-1.5 text-[15px] leading-normal">
          <T v={s.text} />
        </div>
      </li>
    ))}
  </ol>
  <slot />
</section>
