---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { OG_H, OG_NAME, OG_W } from '../lab/media';

interface Props {
  title: string | { en: string; es: string };
  description: string;
  /** Title of link previews; defaults to the English tab title. */
  shareTitle?: string;
  /** Private pages (the dashboard): not indexed and not counted. */
  noindex?: boolean;
  /** Structured data for search engines (JSON-LD), e.g. the landing's Person. */
  schema?: Record<string, unknown>;
}
const { title, description, shareTitle, noindex = false, schema } = Astro.props;
const titles = typeof title === 'string' ? { en: title, es: title } : title;
// Link previews (Open Graph, Twitter card) need absolute URLs.
const url = new URL(Astro.url.pathname, Astro.site);
// The preview is live too (uploaded from /admin, served by worker/media.ts).
const image = new URL(`/media/${OG_NAME}`, Astro.site);
const imageAlt =
  'Juan Diego Londoño, AI Engineer: “I build AI that listens, reasons and acts — inside real software.”';
// Cloudflare Web Analytics (cookieless page views). Set only in production
// builds, so dev and previews don't count.
const beacon = noindex ? undefined : import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JuanDLCH" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={shareTitle ?? titles.en} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(OG_W)} />
    <meta property="og:image:height" content={String(OG_H)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle ?? titles.en} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="author" content="Juan Diego Londoño" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" data-icon />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title data-title={JSON.stringify(titles)}>{titles.en}</title>
    {schema && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
      />
    )}
    <!-- Same-tab navigation between pages keeps JS state alive (Lab demos). -->
    <ClientRouter />
    <script is:inline>
      // Runs before paint: theme and language come from the URL (?lang=),
      // then storage, then the browser. Shared by every page on this origin.
      (function () {
        const root = document.documentElement;
        let store = null;
        try {
          store = window.localStorage;
        } catch {
          /* storage unavailable */
        }
        const get = function (k) {
          try {
            return store && store.getItem(k);
          } catch {
            return null;
          }
        };
        let theme = get('theme');
        if (theme !== 'light' && theme !== 'dark') {
          theme =
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        }
        root.dataset.theme = theme;
        const ic = document.querySelector('link[data-icon]');
        if (ic && theme === 'light')
          ic.setAttribute('href', '/favicon-light.svg');

        const param = new URLSearchParams(location.search).get('lang');
        let lang = param === 'en' || param === 'es' ? param : get('lang');
        if (lang !== 'en' && lang !== 'es') {
          lang = /^es\b/i.test(navigator.language || '') ? 'es' : 'en';
        }
        if (param === lang) {
          try {
            if (store) store.setItem('lang', lang);
          } catch {
            /* storage unavailable */
          }
        }
        root.dataset.lang = lang;
        root.lang = lang;
        const t = document.querySelector('title[data-title]');
        if (t) document.title = JSON.parse(t.dataset.title)[lang];
      })();
    </script>
    {beacon && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beacon, spa: true })}
      />
    )}
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/prefs';
      import '../scripts/hit';
    </script>
  </body>
</html>
