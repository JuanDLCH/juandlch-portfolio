---
// Insights dashboard. Cloudflare Access guards /admin on juandlch.dev and the
// Worker checks its JWT on every /admin/api request (worker/admin.ts); this
// page itself holds no data. The world map is drawn here, at build time.
import AdminApp from '../components/admin/AdminApp';
import Layout from '../layouts/Layout.astro';
import { worldMap } from '../lab/insights/world';

const map = worldMap();
---

<Layout
  title={{
    en: 'Insights — JuanDLCH',
    es: 'Insights — JuanDLCH',
  }}
  description="Private dashboard."
  noindex
>
  <AdminApp client:only="react" map={map} />
</Layout>
