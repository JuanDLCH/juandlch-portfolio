---
import ChatApp from '../../components/lab/ChatApp';
import Layout from '../../layouts/Layout.astro';

// Dev only: the OpenAI key from .env, so it isn't pasted on every reload.
// Builds never read it, so it can't end up in the page.
const devKey: string | undefined = import.meta.env.DEV
  ? import.meta.env.OPENAI_API_KEY
  : undefined;
---

<Layout
  title="Multimodal Chat — JuanDLCH Lab"
  description="Multimodal chat demo running on your own Anthropic key: tool calls, images, PDFs and voice input."
>
  <ChatApp client:load devKey={devKey} />
</Layout>
