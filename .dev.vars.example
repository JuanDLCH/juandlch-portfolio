# Copy to .dev.vars for `pnpm dev:api` (never commit .dev.vars).
OPENAI_API_KEY=sk-...
# Cloudflare's Turnstile test secret: always passes. (2x0000000000000000000000000000000AA always fails.)
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
IP_SALT=dev-only-salt
# 1 = no OpenAI calls at all (fake SDP answer), to test limits and the cutoff.
MOCK_OPENAI=1
# The astro dev origin (the browser posts from it through the proxy).
SITE_ORIGIN=http://localhost:4321
